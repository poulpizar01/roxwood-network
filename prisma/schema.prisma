generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  id                String   @id @default(cuid())
  guildId           String   @unique
  staffRoleIds      String[]
  escalationMinutes Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tickets         Ticket[]
  autoReplyRules  AutoReplyRule[]
  webhooks        WebhookSubscription[]
  ticketCategories TicketCategoryConfig[]
  catalogItems    CatalogItem[]
}

model TicketCategoryConfig {
  id         String     @id @default(cuid())
  guildId    String
  categoryId String
  type       TicketType

  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId])

  @@unique([guildId, categoryId])
}

enum TicketType {
  RECRUITMENT
  SERVICE
}

model Ticket {
  id                String         @id @default(cuid())
  guildId           String
  channelId         String         @unique
  categoryId        String
  type              TicketType
  openerId          String?
  status            TicketStatus   @default(OPEN)
  priority          TicketPriority @default(NORMAL)
  createdAt         DateTime       @default(now())
  closedAt          DateTime?
  firstStaffReplyAt DateTime?
  lastActivityAt    DateTime       @default(now())
  escalatedAt       DateTime?

  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId])
  tags        TicketTag[]
  application RecruitmentApplication?
  order       ServiceOrder?

  @@index([guildId, status])
  @@index([guildId, type])
}

model TicketTag {
  id       String @id @default(cuid())
  ticketId String
  tag      String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tag])
}

model AutoReplyRule {
  id        String   @id @default(cuid())
  guildId   String
  trigger   String
  response  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId])

  @@index([guildId, enabled])
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  guildId   String
  eventType String
  url       String
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  guildConfig GuildConfig @relation(fields: [guildId], references: [guildId])

  @@index([guildId, eventType, enabled])
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RecruitmentApplication {
  id          String            @id @default(cuid())
  ticketId    String            @unique
  status      ApplicationStatus @default(PENDING)
  recruiterId String?
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ticket  Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  answers RecruitmentAnswer[]
}

model RecruitmentAnswer {
  id            String @id @default(cuid())
  applicationId String
  question      String
  answer        String

  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  ACCEPTED
  REJECTED
}

model CatalogItem {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  price       Int
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  guildConfig GuildConfig        @relation(fields: [guildId], references: [guildId])
  fields      CatalogItemField[]
  orderItems  OrderItem[]

  @@index([guildId, active])
}

// Champs definis par le staff pour un article donne : ce que le client doit remplir
// en le commandant. Max 5 par article (limite Discord : un modal a au plus 5 champs).
model CatalogItemField {
  id            String            @id @default(cuid())
  catalogItemId String
  label         String
  style         CatalogFieldStyle
  required      Boolean           @default(true)
  position      Int               @default(0)

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
}

// QUANTITY est un style special : sa reponse alimente OrderItem.quantity (utilise dans le calcul du prix)
// au lieu d'etre juste stockee comme reponse libre. Au plus un champ QUANTITY par article (verifie en code).
enum CatalogFieldStyle {
  SHORT
  PARAGRAPH
  QUANTITY
}

model ServiceOrder {
  id            String        @id @default(cuid())
  ticketId      String        @unique
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  invoiceNumber String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ticket Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  items  OrderItem[]
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  catalogItemId String?
  name          String
  unitPrice     Int
  quantity      Int     @default(1)

  order       ServiceOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  answers     OrderItemAnswer[]
}

// Reponses du client aux champs configures (hors QUANTITY, qui va dans OrderItem.quantity).
model OrderItemAnswer {
  id          String @id @default(cuid())
  orderItemId String
  question    String
  answer      String

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}
